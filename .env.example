# Copy to .env (same folder as AGENTS.md) and fill in what you have. .env is never packaged or logged.
# One provider is enough; GHOST_AUDIT_PROVIDER picks when several keys are present.
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
GHOST_AUDIT_PROVIDER=gemini
# Optional overrides (the layer discovers working models by itself; set these only to force one)
# GHOST_AUDIT_MODEL=gemini-3.5-flash-lite
# GHOST_AUDIT_VISION_MODEL=gemini-3.8-flash
# GHOST_AUDIT_MIN_INTERVAL=4
# GHOST_AUDIT_BATCH_SIZE=25
# GHOST_AUDIT_PRICE_IN=0.30
# GHOST_AUDIT_PRICE_OUT=2.50
# Windows only: full path to tesseract.exe for screenshot OCR
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
